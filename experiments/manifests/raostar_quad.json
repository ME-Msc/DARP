{
  "schema_version": 1,
  "algorithm": {
    "label": "jarvisisfriday-raostar-reimplementation",
    "repository_url": "https://github.com/JarvisIsFriday/RAOStar",
    "commit": "543f782d80ceb9555130e911c1fcf7074153d267",
    "provenance": "The pinned raostar.py identifies this repository as a re-implementation of Pedro Santana's RAO* algorithm; it is not the AAAI-2016 authors' official artifact."
  },
  "license": {
    "status": "license-not-provided"
  },
  "tested_environment": {
    "python": "3.12.3",
    "packages": {
      "numpy": "2.4.6"
    },
    "compatibility_policy": "exact"
  },
  "required_files": [
    "belief.py",
    "raostar.py",
    "raostarhypergraph.py",
    "quad_raos.py",
    "models/quad_model.py"
  ],
  "scenarios": {
    "quad": {
      "adapter": {
        "kind": "upstream-quad"
      },
      "canonical_parameters": {
        "chance_constraint": 0.5,
        "fixed_horizon": 4,
        "world_size": [7, 7],
        "goal_state": [5, 5, 90],
        "quad_initial": [1, 1, 90, 0],
        "guest_initial": [3, 1, 90, 0]
      },
      "experiment_matrix": {
        "fixed_horizons": [2, 3, 4],
        "risk_budgets": [0.0, 0.25, 0.5],
        "full_ilp_max_horizon": 2,
        "hilp_expansion_rounds_per_horizon": 32,
        "smoke_repetitions": 1
      }
    }
  }
}
