// The stochastic movement outcome is sampled for the current action and is
// shared by all next-state CPFs; it is not a persistent belief-state variable.
domain darp_vs_raostar_grid {
    requirements = { partially-observed };

    pvariables {
        max_row             : { non-fluent, int,  default = 4 };
        max_col             : { non-fluent, int,  default = 4 };
        goal_row            : { non-fluent, int,  default = 0 };
        goal_col            : { non-fluent, int,  default = 4 };
        transition_accuracy : { non-fluent, real, default = 0.85 };
        observation_accuracy: { non-fluent, real, default = 0.85 };

        grid_row : { state-fluent, int, default = 0 };
        grid_col : { state-fluent, int, default = 0 };
        row_mod5 : { state-fluent, int, default = 0 };
        col_mod5 : { state-fluent, int, default = 0 };

        // Sampled once per action and shared by every next-state CPF:
        // 0 = intended direction, 1/2 = the two perpendicular slips.
        move_outcome : { interm-fluent, int, level = 1 };

        // With max-nondef-actions=1, all false denotes Left.
        move_up    : { action-fluent, bool, default = false };
        move_right : { action-fluent, bool, default = false };
        move_down  : { action-fluent, bool, default = false };

        // Noisy observation of the number of adjacent boundary walls.
        obs : { observ-fluent, int };
    };

    cpfs {
        move_outcome =
            if ((grid_row == goal_row) & (grid_col == goal_col)) then 0
            else if (Bernoulli(transition_accuracy)) then 0
            else if (Bernoulli(0.5)) then 1
            else 2;

        // Rows increase downwards, as in Constrained-POMDP's GridInstance.
        grid_row' =
            if ((grid_row == goal_row) & (grid_col == goal_col)) then grid_row
            else if (move_up) then
                if (move_outcome == 0) then
                    if (grid_row == 0) then grid_row else grid_row - 1
                else grid_row
            else if (move_right) then
                if (move_outcome == 1) then
                    if (grid_row == max_row) then grid_row else grid_row + 1
                else if (move_outcome == 2) then
                    if (grid_row == 0) then grid_row else grid_row - 1
                else grid_row
            else if (move_down) then
                if (move_outcome == 0) then
                    if (grid_row == max_row) then grid_row else grid_row + 1
                else grid_row
            else
                if (move_outcome == 1) then
                    if (grid_row == max_row) then grid_row else grid_row + 1
                else if (move_outcome == 2) then
                    if (grid_row == 0) then grid_row else grid_row - 1
                else grid_row;

        grid_col' =
            if ((grid_row == goal_row) & (grid_col == goal_col)) then grid_col
            else if (move_up) then
                if (move_outcome == 1) then
                    if (grid_col == 0) then grid_col else grid_col - 1
                else if (move_outcome == 2) then
                    if (grid_col == max_col) then grid_col else grid_col + 1
                else grid_col
            else if (move_right) then
                if (move_outcome == 0) then
                    if (grid_col == max_col) then grid_col else grid_col + 1
                else grid_col
            else if (move_down) then
                if (move_outcome == 1) then
                    if (grid_col == 0) then grid_col else grid_col - 1
                else if (move_outcome == 2) then
                    if (grid_col == max_col) then grid_col else grid_col + 1
                else grid_col
            else
                if (move_outcome == 0) then
                    if (grid_col == 0) then grid_col else grid_col - 1
                else grid_col;

        row_mod5' =
            if ((grid_row == goal_row) & (grid_col == goal_col)) then row_mod5
            else if (move_up) then
                if ((move_outcome == 0) & (grid_row > 0)) then
                    if (row_mod5 == 0) then 4 else row_mod5 - 1
                else row_mod5
            else if (move_right) then
                if ((move_outcome == 1) & (grid_row < max_row)) then
                    if (row_mod5 == 4) then 0 else row_mod5 + 1
                else if ((move_outcome == 2) & (grid_row > 0)) then
                    if (row_mod5 == 0) then 4 else row_mod5 - 1
                else row_mod5
            else if (move_down) then
                if ((move_outcome == 0) & (grid_row < max_row)) then
                    if (row_mod5 == 4) then 0 else row_mod5 + 1
                else row_mod5
            else
                if ((move_outcome == 1) & (grid_row < max_row)) then
                    if (row_mod5 == 4) then 0 else row_mod5 + 1
                else if ((move_outcome == 2) & (grid_row > 0)) then
                    if (row_mod5 == 0) then 4 else row_mod5 - 1
                else row_mod5;

        col_mod5' =
            if ((grid_row == goal_row) & (grid_col == goal_col)) then col_mod5
            else if (move_up) then
                if ((move_outcome == 1) & (grid_col > 0)) then
                    if (col_mod5 == 0) then 4 else col_mod5 - 1
                else if ((move_outcome == 2) & (grid_col < max_col)) then
                    if (col_mod5 == 4) then 0 else col_mod5 + 1
                else col_mod5
            else if (move_right) then
                if ((move_outcome == 0) & (grid_col < max_col)) then
                    if (col_mod5 == 4) then 0 else col_mod5 + 1
                else col_mod5
            else if (move_down) then
                if ((move_outcome == 1) & (grid_col > 0)) then
                    if (col_mod5 == 0) then 4 else col_mod5 - 1
                else if ((move_outcome == 2) & (grid_col < max_col)) then
                    if (col_mod5 == 4) then 0 else col_mod5 + 1
                else col_mod5
            else
                if ((move_outcome == 0) & (grid_col > 0)) then
                    if (col_mod5 == 0) then 4 else col_mod5 - 1
                else col_mod5;

        obs =
            if (((grid_row' == 0) | (grid_row' == max_row)) &
                ((grid_col' == 0) | (grid_col' == max_col))) then
                if (Bernoulli(observation_accuracy)) then 2
                else if (Bernoulli(0.5)) then 1 else 0
            else if ((grid_row' == 0) | (grid_row' == max_row) |
                     (grid_col' == 0) | (grid_col' == max_col)) then
                if (Bernoulli(observation_accuracy)) then 1
                else if (Bernoulli(0.5)) then 2 else 0
            else
                if (Bernoulli(observation_accuracy)) then 0
                else if (Bernoulli(0.5)) then 2 else 1;
    };

    reward = if ((grid_row == goal_row) & (grid_col == goal_col)) then 0 else -1;

    termination {
        (grid_row == goal_row) & (grid_col == goal_col);
    };
}
