domain darp_vs_raostar_science_agent {
    requirements = { partially-observed };

    pvariables {
        low_path_risk        : { non-fluent, real, default = 0.001 };
        high_path_risk       : { non-fluent, real, default = 0.01 };
        discovery_accuracy   : { non-fluent, real, default = 0.9 };
        prior_minerals       : { non-fluent, real, default = 0.5 };
        prior_funny_rock     : { non-fluent, real, default = 0.5 };
        prior_geiser         : { non-fluent, real, default = 0.5 };
        prior_alien_lair     : { non-fluent, real, default = 0.2 };

        // site: 0=start, 1=minerals, 2=funny rock, 3=geiser,
        //       4=alien lair, 5=relay, 6=crash.
        site : { state-fluent, int, default = 0 };

        visited_minerals   : { state-fluent, bool, default = false };
        visited_funny_rock : { state-fluent, bool, default = false };
        visited_geiser     : { state-fluent, bool, default = false };
        visited_alien_lair : { state-fluent, bool, default = false };

        // Static hidden facts sampled by darp_runner.initial_belief().
        has_minerals   : { state-fluent, bool, default = false };
        has_funny_rock : { state-fluent, bool, default = false };
        has_geiser     : { state-fluent, bool, default = false };
        has_alien_lair : { state-fluent, bool, default = false };

        // The all-false RDDL action is go-to-relay at risk 0.001.
        go_minerals_low   : { action-fluent, bool, default = false };
        go_minerals_high  : { action-fluent, bool, default = false };
        go_funny_rock_low : { action-fluent, bool, default = false };
        go_funny_rock_high: { action-fluent, bool, default = false };
        go_geiser_low     : { action-fluent, bool, default = false };
        go_geiser_high    : { action-fluent, bool, default = false };
        go_alien_lair_low : { action-fluent, bool, default = false };
        go_alien_lair_high: { action-fluent, bool, default = false };
        go_relay_high     : { action-fluent, bool, default = false };

        // even=none at site, odd=new discovery at site, 12=obstacle/crash.
        obs : { observ-fluent, int };
    };

    cpfs {
        site' =
            if ((site == 5) | (site == 6)) then site
            else if (Bernoulli(
                if (go_minerals_high | go_funny_rock_high |
                    go_geiser_high | go_alien_lair_high | go_relay_high)
                then high_path_risk else low_path_risk
            )) then 6
            else if (go_minerals_low | go_minerals_high) then 1
            else if (go_funny_rock_low | go_funny_rock_high) then 2
            else if (go_geiser_low | go_geiser_high) then 3
            else if (go_alien_lair_low | go_alien_lair_high) then 4
            else 5;

        // The original model marks the source site visited when departing.
        visited_minerals'   = visited_minerals   | (site == 1);
        visited_funny_rock' = visited_funny_rock | (site == 2);
        visited_geiser'     = visited_geiser     | (site == 3);
        visited_alien_lair' = visited_alien_lair | (site == 4);

        has_minerals'   = has_minerals;
        has_funny_rock' = has_funny_rock;
        has_geiser'     = has_geiser;
        has_alien_lair' = has_alien_lair;

        obs =
            if (site' == 6) then 12
            else if (site' == 1) then
                if (has_minerals' & Bernoulli(discovery_accuracy)) then 3 else 2
            else if (site' == 2) then
                if (has_funny_rock' & Bernoulli(discovery_accuracy)) then 5 else 4
            else if (site' == 3) then
                if (has_geiser' & Bernoulli(discovery_accuracy)) then 7 else 6
            else if (site' == 4) then
                if (has_alien_lair' & Bernoulli(discovery_accuracy)) then 9 else 8
            else 10;
    };

    // CCRockSample.value() pays once, when the rover departs a discovered site.
    reward =
        if ((site == 1) & ~visited_minerals & has_minerals) then 10
        else if ((site == 2) & ~visited_funny_rock & has_funny_rock) then 5
        else if ((site == 3) & ~visited_geiser & has_geiser) then 4
        else if ((site == 4) & ~visited_alien_lair & has_alien_lair) then 100
        else 0;

    termination {
        (site == 5) | (site == 6);
    };
}
