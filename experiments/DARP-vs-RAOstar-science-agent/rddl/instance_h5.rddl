non-fluents science_agent_h5_nf {
    domain = darp_vs_raostar_science_agent;
    non-fluents {
        low_path_risk = 0.001;
        high_path_risk = 0.01;
        discovery_accuracy = 0.9;
        prior_minerals = 0.5;
        prior_funny_rock = 0.5;
        prior_geiser = 0.5;
        prior_alien_lair = 0.2;
    };
}

instance science_agent_h5 {
    domain = darp_vs_raostar_science_agent;
    non-fluents = science_agent_h5_nf;
    init-state {
        site = 0;
    };
    max-nondef-actions = 1;
    horizon = 5;
    discount = 1.0;
}
