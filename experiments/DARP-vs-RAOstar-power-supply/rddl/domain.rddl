// Reduced probabilistic PSR benchmark.
// Topology: CB1 -- l1 -- SD1 -- l2 -- SD2 -- l3 -- CB2.
// This is the three-line example in Bonet & Thiebaux (ICAPS 2003, fn. 6),
// itself an executable formalization of Thiebaux & Cordier (ECP 2001).
// The fault prior, horizon, sensor subsets and chance constraint are explicit
// DARP experiment choices; this is not the unpublished RAO* Table 2 instance.
domain darp_vs_raostar_power_supply {
    requirements = { partially-observed };

    pvariables {
        sensor_count     : { non-fluent, int, default = 2 };
        last_action_depth: { non-fluent, int, default = 3 };
        line_penalty     : { non-fluent, real, default = 5.0 };

        // Exactly one hidden fault: 1=l1 or 2=l2 in this experiment.
        fault : { state-fluent, int, default = 1 };

        cb1_closed : { state-fluent, bool, default = false };
        sd1_closed : { state-fluent, bool, default = true };
        sd2_closed : { state-fluent, bool, default = false };
        cb2_closed : { state-fluent, bool, default = true };
        unsafe     : { state-fluent, bool, default = false };
        done       : { state-fluent, bool, default = false };
        depth      : { state-fluent, int, default = 0 };

        open_cb1 : { action-fluent, bool, default = false };
        close_cb1: { action-fluent, bool, default = false };
        open_sd1 : { action-fluent, bool, default = false };
        close_sd1: { action-fluent, bool, default = false };
        open_sd2 : { action-fluent, bool, default = false };
        close_sd2: { action-fluent, bool, default = false };
        open_cb2 : { action-fluent, bool, default = false };
        close_cb2: { action-fluent, bool, default = false };

        // bit 0=CB1 closed; bit 1=CB2 closed. With one sensor only bit 0 is used.
        obs : { observ-fluent, int };
    };

    cpfs {
        fault' = fault;

        sd1_closed' = ~open_sd1 & (close_sd1 | sd1_closed);
        sd2_closed' = ~open_sd2 & (close_sd2 | sd2_closed);

        // A breaker closes only if the resulting path does not energize a fault.
        // These CPFs inline the requested switch positions because RDDL CPFs are
        // synchronous: every next-state fluent reads the same current state/action.
        cb1_closed' =
            (~open_cb1 & (close_cb1 | cb1_closed)) &
            ~(
                (fault == 1) |
                ((~open_sd1 & (close_sd1 | sd1_closed)) & (fault == 2)) |
                ((~open_sd1 & (close_sd1 | sd1_closed)) &
                 (~open_sd2 & (close_sd2 | sd2_closed)) & (fault == 3))
            );

        cb2_closed' =
            (~open_cb2 & (close_cb2 | cb2_closed)) &
            ~(
                (fault == 3) |
                ((~open_sd2 & (close_sd2 | sd2_closed)) & (fault == 2)) |
                ((~open_sd2 & (close_sd2 | sd2_closed)) &
                 (~open_sd1 & (close_sd1 | sd1_closed)) & (fault == 1))
            );

        // The violation is deliberately nonterminal, as in the RAO* PSR domain.
        unsafe' = unsafe |
            ((~open_cb1 & (close_cb1 | cb1_closed)) &
                ((fault == 1) |
                 ((~open_sd1 & (close_sd1 | sd1_closed)) & (fault == 2)) |
                 ((~open_sd1 & (close_sd1 | sd1_closed)) &
                  (~open_sd2 & (close_sd2 | sd2_closed)) & (fault == 3)))) |
            ((~open_cb2 & (close_cb2 | cb2_closed)) &
                ((fault == 3) |
                 ((~open_sd2 & (close_sd2 | sd2_closed)) & (fault == 2)) |
                 ((~open_sd2 & (close_sd2 | sd2_closed)) &
                  (~open_sd1 & (close_sd1 | sd1_closed)) & (fault == 1))));

        // The all-false RDDL action is the paper encoding's finish action.
        done' = done | ~(
            open_cb1 | close_cb1 | open_sd1 | close_sd1 |
            open_sd2 | close_sd2 | open_cb2 | close_cb2
        );
        depth' = if (done) then depth else depth + 1;

        obs =
            if (sensor_count == 1) then
                if (cb1_closed') then 1 else 0
            else if (cb1_closed') then
                if (cb2_closed') then 3 else 1
            else if (cb2_closed') then 2 else 0;
    };

    // Every switching operation costs one. Finish costs five per healthy line
    // still without supply, exactly as in the GPT formalization. If the finite
    // horizon is exhausted, the same final penalty is charged after the action.
    reward =
        if (done) then 0
        else if (~(
            open_cb1 | close_cb1 | open_sd1 | close_sd1 |
            open_sd2 | close_sd2 | open_cb2 | close_cb2
        )) then -(
            if ((~(fault == 1)) &
                ~(cb1_closed | (cb2_closed & sd2_closed & sd1_closed)))
                then line_penalty else 0
        ) - (
            if ((~(fault == 2)) &
                ~((cb1_closed & sd1_closed) | (cb2_closed & sd2_closed)))
                then line_penalty else 0
        ) - (
            if ((~(fault == 3)) &
                ~(cb2_closed | (cb1_closed & sd1_closed & sd2_closed)))
                then line_penalty else 0
        )
        else -1 - (
            if (depth == last_action_depth) then
                (if ((~(fault' == 1)) &
                     ~(cb1_closed' | (cb2_closed' & sd2_closed' & sd1_closed')))
                     then line_penalty else 0) +
                (if ((~(fault' == 2)) &
                     ~((cb1_closed' & sd1_closed') | (cb2_closed' & sd2_closed')))
                     then line_penalty else 0) +
                (if ((~(fault' == 3)) &
                     ~(cb2_closed' | (cb1_closed' & sd1_closed' & sd2_closed')))
                     then line_penalty else 0)
            else 0
        );

    termination {
        done | (depth > last_action_depth);
    };
}
