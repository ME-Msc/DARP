{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DARP: RDDL + sidecars",
      "type": "debugpy",
      "request": "launch",
      "module": "darp",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false,
      "stopOnEntry": false,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONHASHSEED": "0",
        "PYTHONUNBUFFERED": "1"
      },
      "args": [
        "--domain",
        "${workspaceFolder}/experiments/DARP-vs-RAOstar-grid/rddl/domain.rddl",
        "--instance",
        "${workspaceFolder}/experiments/DARP-vs-RAOstar-grid/rddl/instance_5_h3.rddl",
        "--duration",
        "${workspaceFolder}/experiments/DARP-vs-RAOstar-grid/rddl/duration.json",
        "--risk",
        "${workspaceFolder}/experiments/DARP-vs-RAOstar-grid/rddl/risk.json",
        "--planner",
        "hilp",
        "--heuristic",
        "experiments.DARP-vs-RAOstar-grid.darp_runner:MANHATTAN",
        "--terminal-heuristic",
        "--seed",
        "0",
        "--timeout",
        "86400",
        "--output",
        "${workspaceFolder}/output/DARP-vs-RAOstar-grid/darp-debug.json"
      ]
    }
  ]
}
