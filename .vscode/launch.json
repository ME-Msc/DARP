{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DARP: RDDL",
      "type": "debugpy",
      "request": "launch",
      "module": "darp",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false,
      "stopOnEntry": false,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONHASHSEED": "0",
        "PYTHONUNBUFFERED": "1"
      },
      "args": [
        "--domain",
        "${workspaceFolder}/benchmarks/grid/fixed-duration/domain.rddl",
        "--instance",
        "${workspaceFolder}/benchmarks/grid/fixed-duration/grid-5x5-h3-d1-r1-b0.1.rddl",
        "--planner",
        "hilp",
        "--heuristic",
        "benchmarks.grid.heuristic:MANHATTAN",
        "--terminal-heuristic",
        "--rank-alpha",
        "1.0",
        "--rank-lambda",
        "1.0",
        "--seed",
        "0",
        "--timeout",
        "86400",
        "--output",
        "${workspaceFolder}/experiments/grid/runs/debug/policies/darp-debug.json"
      ]
    }
  ]
}
